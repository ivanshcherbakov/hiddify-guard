  <sys:String x:Key="Show">Открыть Hiddify Guard</sys:String>
  <sys:String x:Key="Exit">Выйти (защита останется)</sys:String>
  <sys:String x:Key="TrayHint">Hiddify Guard — защита остаётся активной</sys:String>
  <sys:String x:Key="Auto">Автоматически</sys:String>
  <sys:String x:Key="Preview">Предпросмотр интерфейса — изменение правил недоступно.</sys:String>
  <sys:String x:Key="LanOn">Домашняя сеть разрешена</sys:String>
