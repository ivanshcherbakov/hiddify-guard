  <sys:String x:Key="Missing">Hiddify не найден</sys:String>
  <sys:String x:Key="MissingDetail">Установите Hiddify или укажите, где находится Hiddify.exe.</sys:String>
  <sys:String x:Key="Locate">Указать Hiddify.exe</sys:String>
  <sys:String x:Key="Rescan">Пересканировать Hiddify</sys:String>
  <sys:String x:Key="LeakTest">Проверить защиту</sys:String>
  <sys:String x:Key="Logs">Открыть папку логов</sys:String>
  <sys:String x:Key="Testing">Проверка… Это может занять до 12 секунд.</sys:String>
  <sys:String x:Key="ExternalIp">Внешний IP</sys:String>
