<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="Subtitle">Помощник для безопасного подключения</sys:String>
  <sys:String x:Key="Off">Защита выключена</sys:String>
  <sys:String x:Key="On">Защита включена</sys:String>
  <sys:String x:Key="Waiting">Hiddify не подключён</sys:String>
  <sys:String x:Key="Degraded">Защита требует проверки</sys:String>
  <sys:String x:Key="Unknown">Не удалось прочитать состояние</sys:String>
  <sys:String x:Key="OffDetail">Включите защиту, чтобы ограничить исходящие соединения.</sys:String>
  <sys:String x:Key="OnDetail">Защита активна, Hiddify обнаружен. Доступность интернета можно проверить в настройках.</sys:String>
  <sys:String x:Key="WaitDetail">Защита ограничивает выход в интернет. Откройте Hiddify и подключитесь.</sys:String>
  <sys:String x:Key="DegradedDetail">Нужно обновить правила защиты в дополнительных настройках.</sys:String>
  <sys:String x:Key="Enable">Включить защиту</sys:String>
  <sys:String x:Key="Disable">Отключить защиту</sys:String>
  <sys:String x:Key="Working">Применение…</sys:String>
  <sys:String x:Key="OpenHiddify">Открыть Hiddify</sys:String>
  <sys:String x:Key="Advanced">Дополнительные настройки</sys:String>
  <sys:String x:Key="Language">Язык интерфейса</sys:String>
  <sys:String x:Key="Folder">Папка с Hiddify.exe</sys:String>
  <sys:String x:Key="Browse">Выбрать…</sys:String>
