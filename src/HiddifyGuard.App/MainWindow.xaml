<Window x:Class="HiddifyGuard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hiddify Guard" Width="460" Height="650" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Segoe UI"
        Foreground="#17253B" Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Background" Value="#E7ECF3"/>
            <Setter Property="Foreground" Value="#17253B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}" Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CFD7E4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,22">
            <TextBlock Text="Hiddify Guard" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="Subtitle" Margin="0,7,0,24" FontSize="14" Foreground="#64748B"/>
            <Border CornerRadius="18" Background="White" Padding="26">
                <StackPanel>
                    <Border x:Name="StatusBadge" Width="90" Height="90" Background="#EDF0F5"
                            CornerRadius="45" HorizontalAlignment="Center" Margin="0,4,0,22">
                        <Path x:Name="StatusShield" Width="40" Height="48" Stretch="Fill" Fill="#7F8B9D"
                              Data="M20,0 L40,8 L37,30 Q34,42 20,48 Q6,42 3,30 L0,8 Z"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="StatusTitle" Text="…" FontSize="24" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusDetail" FontSize="14" Foreground="#64748B" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,12,0,20" MinHeight="42"/>
                    <Button x:Name="ToggleButton" Click="OnToggle" Background="#2563EB" Foreground="White"
                            FontSize="17" FontWeight="SemiBold" MinHeight="56" IsEnabled="False"/>
                    <Button x:Name="OpenHiddifyButton" Click="OnOpenHiddify" Background="#FFF0CB" Foreground="#7D4C00"
                            FontWeight="SemiBold" Margin="0,12,0,0" Visibility="Collapsed" MinHeight="48"/>
                    <TextBlock x:Name="ConnectionNote" FontSize="12" Foreground="#7B8798" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,18,0,0"/>
                </StackPanel>
            </Border>
            <Expander x:Name="Advanced" Margin="0,22,0,0" FontSize="14">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock x:Name="LanguageLabel" Margin="0,0,0,6"/>
                    <ComboBox x:Name="LanguageBox" Padding="8" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem x:Name="AutoLanguage" Tag="auto"/>
                        <ComboBoxItem Content="Русский" Tag="ru"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                    <TextBlock x:Name="FolderLabel" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" VerticalContentAlignment="Center"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Click="OnBrowse"/>
                    </Grid>
                    <CheckBox x:Name="AllowLanBox" Margin="0,18,0,6" Checked="OnLanChanged" Unchecked="OnLanChanged"/>
                    <TextBlock x:Name="LanHelp" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="SaveButton" Click="OnSave"/>
                        <Button x:Name="RepairButton" Click="OnRepair" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="DiscoveryDetail" Margin="0,14,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="RescanButton" Click="OnRescan" Margin="0,0,8,8"/>
                        <Button x:Name="LeakTestButton" Click="OnLeakTest" Margin="0,0,0,8"/>
                        <Button x:Name="LogsButton" Click="OnLogs"/>
                    </WrapPanel>
                    <TextBlock x:Name="DiagnosticsOutput" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TechnicalNote" Margin="0,12,0,0" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>
            <TextBlock x:Name="Footer" Margin="0,24,0,0" Foreground="#718096" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
